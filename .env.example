# Copy to .env — every value below is validated by packages/config at boot (Appendix A).
NODE_ENV=development
LOG_LEVEL=debug

# ── infrastructure (matches infra/docker-compose.yml) ─────────────────────
# No Docker? Use in-process Postgres instead (single process, dev only):
#   DATABASE_URL=pglite://./.data/nexus
# App role (RLS applies). Migrations and the drift gate use DATABASE_ADMIN_URL (table owner).
DATABASE_URL=postgresql://nexus_app:nexus_app@localhost:5432/nexus
DATABASE_ADMIN_URL=postgresql://nexus:nexus@localhost:5432/nexus
SHADOW_DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus_shadow
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nexus
S3_ACCESS_KEY=nexus
S3_SECRET_KEY=nexus-secret
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ── app ────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
WEB_PORT=3000
WORKER_HEALTH_PORT=3001
# openssl rand -base64 48
AUTH_SECRET=change-me-change-me-change-me-change-me-change-me
# local:* uses ENCRYPTION_KEY_FALLBACK as the master key (dev/test only). Production: a KMS key id.
KMS_MASTER_KEY_ID=local:dev
# openssl rand -base64 32
ENCRYPTION_KEY_FALLBACK=

# ── auth & mail (Phase 1) ──────────────────────────────────────────────────
# Magic links go out through SMTP_URL (Mailpit locally). Google sign-in reuses GOOGLE_CLIENT_ID/SECRET.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Nexus <no-reply@nexus.local>
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Test-only sign-in endpoint for Playwright (ADR-012). Never set in production.
E2E_AUTH_BYPASS=false

# ── platforms (optional until a connection of that platform is enabled) ───
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v26.0
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BILLING_MODE=payg
X_CYCLE_SPEND_CAP_USD=
X_CYCLE_POST_READ_CAP=3000000
X_SPEND_ALERT_PCT=80
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=
YOUTUBE_DAILY_UNIT_BUDGET=10000
YOUTUBE_SEARCH_DAILY_CALLS=100
YOUTUBE_INSERT_DAILY_CALLS=100
KEITARO_DEFAULT_RPS=2
KEITARO_DEFAULT_CONCURRENCY=2
KEITARO_WEBHOOK_SECRET_BYTES=32

# ── AI ─────────────────────────────────────────────────────────────────────
AI_PROVIDER=disabled
AI_API_KEY=
AI_MONTHLY_TOKEN_BUDGET=0
AI_PII_REDACTION=strict

# ── observability (Jaeger from docker-compose) ────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# ── feature flags ──────────────────────────────────────────────────────────
FEATURE_GMAIL=false
FEATURE_ADS=false
FEATURE_MOCK_PLATFORM=true
