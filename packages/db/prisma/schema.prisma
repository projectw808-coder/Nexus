}

enum ViewLayout {
  TABLE
  BOARD
  CALENDAR
  TIMELINE
}

/// §9.2 failure taxonomy.
enum IntegrationErrorClass {
  AUTH_EXPIRED
  SCOPE_MISSING
  RATE_LIMITED
  QUOTA_EXHAUSTED
  PLATFORM_DOWN
  SCHEMA_DRIFT
  POLICY_BLOCKED
  DUPLICATE
  UNKNOWN
}

enum VaultKind {
  OAUTH_TOKEN
  API_KEY
  WEBHOOK_SECRET
  SIGNING_SECRET
}

enum ApiKeyScope {
  READ
  WRITE
  ADMIN
}

enum OutboundDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
