// =============================================================================
// Nexus CRM — Prisma schema (Phases 0–2)
//
// Conventions (see packages/db/README.md):
//   * Every model:   id String @id @default(uuid()), createdAt, updatedAt, and
//                    deletedAt (soft delete) unless the model is a pure
//                    append-only log — those say so in a comment.
//   * Tenant models: carry `workspaceId` with onDelete: Cascade, and
//                    `workspaceId` is the FIRST column of every composite
//                    index / unique. TENANT_MODELS is generated from the DMMF
//                    by filtering models that have a `workspaceId` field
//                    (scripts/gen-tenant-models.ts), so a new model cannot be
//                    forgotten by the scoped client.
//   * Non-tenant:    User, Account, Session, VerificationToken (Auth.js) and
//                    PlatformComplianceNote (operator-maintained platform
//                    reference content, see ADR-004).
//   * Prisma 7:      no `url` on the datasource — it comes from
//                    prisma.config.ts. Objects Prisma cannot express (GIN on
//                    jsonb_path_ops, tsvector GIN, HNSW on vectors, RLS
//                    helper) are hand-written SQL appended to the initial
//                    migration under the `-- nexus:managed-outside-schema`
//                    marker and listed in prisma/drift-allowlist.json.
// =============================================================================

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  previewFeatures        = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, pg_trgm, citext]
}

// =============================================================================
// Enums
// =============================================================================

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

/// Per-connection grant permission (§5.2).
enum ConnPermission {
  READ
  ENGAGE
  PUBLISH
  CONFIGURE
}

/// Who a ConnectionGrant applies to: a Role name or a specific User.
enum GrantSubjectType {
  ROLE
  USER
}

/// Field-level access for AttributePermission (§5.2).
enum AttributeAccess {
  HIDDEN
  READ
  WRITE
}

/// Mirrored verbatim in packages/connectors/sdk — keep the order and values in sync.
enum Platform {
  FACEBOOK
  INSTAGRAM
  X
  LINKEDIN
  TIKTOK
  YOUTUBE
  GMAIL
  GOOGLE_CALENDAR
  GOOGLE_BUSINESS
  KEITARO
  MOCK
}

enum AttributeType {
  TEXT
  NUMBER
  CURRENCY
  DATE
  DATETIME
  SELECT
  MULTISELECT
  BOOLEAN
  EMAIL
  PHONE
  URL
  RATING
  STATUS
  RELATIONSHIP
  USER
  LOCATION
  AI_RESEARCH
  FORMULA
  ROLLUP
  SOCIAL_HANDLE
}

/// Lifecycle of an attribute's generated column + btree (§6.6, ADR-009).
enum IndexState {
  NONE
  BUILDING
  READY
  FAILED
  DROPPING
}

/// CSV import lifecycle (§16 Phase 2).
enum ImportStatus {
  PREVIEW
  RUNNING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum ListKind {
  PIPELINE
  COLLECTION
}

enum ConvStatus {
  OPEN
  SNOOZED
  CLOSED
  SPAM
}

enum ConversationKind {
  DM
  COMMENT_THREAD
  MENTION
  REVIEW
  EMAIL_THREAD
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum DeliveryState {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum TimelineType {
  MESSAGE
  COMMENT
  MENTION
  POST_ENGAGEMENT
  LEAD_FORM
  EMAIL
  MEETING
  CALL
  NOTE
  TASK
  STAGE_CHANGE
  FIELD_CHANGE
  DEAL_EVENT
  AI_INSIGHT
  SYSTEM
}

enum LinkMethod {
  EXACT_EMAIL
  PHONE
  OAUTH_SELF
  DOMAIN
  NAME_FUZZY
  HANDLE_MATCH
  MANUAL
  AI_INFERRED
  PLATFORM_PROVIDED
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  AUTO_MERGED
  EXPIRED
}

enum ConnStatus {
  CONNECTED
  DEGRADED
  PAUSED
  RECONNECT_REQUIRED
  REVOKED
}

enum SyncTrigger {
  BACKFILL
  SCHEDULE
  WEBHOOK
  MANUAL
  REPLAY
}

/// Shared by SyncRun and WorkflowRun.
enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum OutboundStatus {
  DRAFT
  PENDING_APPROVAL
  QUEUED
  SENDING
  SENT
  FAILED
  BLOCKED
  CANCELLED
}

/// Record.mergeState — a MERGED record is the loser of a RecordMerge and
/// points at the winner via mergedIntoId. Never deleted (§10: reversible forever).
enum MergeState {
  ACTIVE
  MERGED
}

/// Who performed an audited action.
enum ActorType {
  USER
  API_KEY
  SYSTEM
  WORKFLOW
  CONNECTOR
}

enum AiInsightKind {
  SUMMARY
  SENTIMENT
  INTENT
  NEXT_BEST_ACTION
